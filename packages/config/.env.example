# CamerMove — config package .env template
#
# Every variable below is declared in packages/config/src/env.ts (single Zod schema).
# Defaults shown here match the schema defaults and are safe for local docker-compose dev.
# Copy to `packages/config/.env` (gitignored) or repo-root `.env` and adjust.

# ─── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3002

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://camermove:camermove@localhost:5432/camermove

# ─── Redis (BullMQ + cache + rate limit + idempotency) ────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Kafka (durable event backbone) ───────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ─── MinIO (S3-compatible object storage) ─────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=camermove

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_RANDOM

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ─── NotchPay (payments) ──────────────────────────────────────────────────────
NOTCHPAY_BASE_URL=https://api.notchpay.co
NOTCHPAY_PUBLIC_KEY=REPLACE_ME
NOTCHPAY_PRIVATE_KEY=REPLACE_ME
NOTCHPAY_HASH_KEY=REPLACE_ME

# ─── CinetPay (alt payments provider) ─────────────────────────────────────────
CINETPAY_APIKEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com

# ─── Twilio (SMS + WhatsApp) ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── ntfy (push notifications) ────────────────────────────────────────────────
NTFY_BASE_URL=http://localhost:8090
NTFY_HOST=https://ntfy.sh
NTFY_TOKEN=
# NOTIF_DRIVER picks the notification driver (email|sms|whatsapp|push); optional override
NOTIF_DRIVER=

# ─── SMTP (transactional email) ───────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@camermove.cm
SMTP_SECURE=false

# ─── Observability ────────────────────────────────────────────────────────────
METRICS_ENABLED=false
METRICS_PORT=4000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info

# ─── Rate limits (IP layer) ───────────────────────────────────────────────────
RATE_LIMIT_IP_GENERAL_MAX=100
RATE_LIMIT_IP_AUTH_MAX=10
RATE_LIMIT_IP_SEARCH_MAX=30
RATE_LIMIT_IP_TICKETS_LOOKUP_MAX=20
RATE_LIMIT_IP_CONTACT_MAX=10

# ─── Rate limits (App-wide layer) ─────────────────────────────────────────────
RATE_LIMIT_APP_GENERAL_MAX=5000
RATE_LIMIT_APP_AUTH_MAX=500
RATE_LIMIT_APP_SEARCH_MAX=1000
RATE_LIMIT_APP_TICKETS_LOOKUP_MAX=60
RATE_LIMIT_APP_CONTACT_MAX=500

# ─── Rate limit window (ms) ───────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000

# ─── Pagination ───────────────────────────────────────────────────────────────
PAGINATION_MAX_PER_PAGE=100
PAGINATION_DEFAULT_PER_PAGE=20

# ─── Bulk operations ──────────────────────────────────────────────────────────
BULK_MAX_IDS=100

# ─── Search ───────────────────────────────────────────────────────────────────
SEARCH_MAX_LIMIT=100
SEARCH_DEFAULT_LIMIT=20

# ─── App settings (superadmin) ────────────────────────────────────────────────
# These mirror AppSettings row defaults; override DB-side via /api/v1/admin/settings.
# COMMISSION_PERCENT_DEFAULT=10
# HOLD_EXPIRY_MINUTES_DEFAULT=15